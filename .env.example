# ------------------------------------------------------------------
#  Copy this file to  .env  and fill in your own keys.
#  ( .env is ignored by git - never commit real keys )
# ------------------------------------------------------------------

# --- Text / image generation (free tiers) -------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
OUTROUTER_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=

# --- YouTube upload (optional; leave empty if you use client_secret.json)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Paths / options ---------------------------------------------
# SAAS_OUTPUT_DIR=          # result folder (default: <project>\output)
# WEBAPP_PORT=8765
# SD_DEVICE=cuda            # cuda / cpu
# SD_LOCAL_CHECKPOINT=      # override SDXL-Turbo folder   (default: <project>\model\sdxl-turbo)
# SD_GGUF_CHECKPOINT=       # override SD3.5 GGUF file     (default: <project>\model\sd3.5_large_turbo-q4_k_4_0.gguf)
# FFMPEG_DIR=               # override FFmpeg bin folder  (default: <project>\ffmpeg8\...\bin)
